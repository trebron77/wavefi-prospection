# =============================================================================
# Agent autonome local - modèle de configuration
# -----------------------------------------------------------------------------
# 1) Copiez ce fichier :   Copy-Item .env.example .env
# 2) Renseignez vos valeurs ci-dessous.
# 3) `.env` est exclu par .gitignore : ne le commitez JAMAIS.
# =============================================================================

# --- Identifiants ------------------------------------------------------------
# Clé API du fournisseur.
#   - Fournisseur distant (OpenAI, Groq, Mistral...) : obligatoire.
#   - Serveur local (Ollama, LM Studio) : inutile, laissez vide.
LLM_API_KEY=

# URL de base de l'API. Vide ou absente = OpenAI.
#   Ollama     : http://localhost:11434/v1
#   LM Studio  : http://localhost:1234/v1
#   Groq       : https://api.groq.com/openai/v1
#   Mistral    : https://api.mistral.ai/v1
LLM_BASE_URL=https://api.openai.com/v1

# Modèle utilisé pour le raisonnement et les appels d'outils.
#   OpenAI : gpt-4o-mini          (bon compromis coût/qualité)
#   Ollama : qwen2.5-coder:7b     (bon en code, tourne en local)
#   Groq   : llama-3.3-70b-versatile
LLM_MODEL=gpt-4o-mini

# --- Paramètres de génération -------------------------------------------------
# 0 = déterministe (recommandé pour un agent qui modifie du code).
# "none" pour omettre le paramètre (utile avec les modèles de raisonnement o1/o3).
LLM_TEMPERATURE=0

# Longueur maximale de la réponse du modèle, en tokens.
LLM_MAX_TOKENS=4096

# --- Réseau et résilience -----------------------------------------------------
# Délai maximal d'un appel, en secondes.
LLM_TIMEOUT=60

# Tentatives supplémentaires gérées automatiquement par le SDK
# (backoff exponentiel sur les erreurs réseau, 429 et 5xx).
LLM_MAX_RETRIES=3

# --- Boucle agentique ---------------------------------------------------------
# Nombre maximal d'itérations « le LLM demande un outil -> l'agent l'exécute ».
MAX_ITERATIONS=15

# --- Prospection : vérification d'adresses (find_atn_emails.py) --------------
# Clé de l'API Hunter.io (https://hunter.io/api-keys), utilisée par l'endpoint
# email-verifier de find_atn_emails.py. Le script la cherche aussi dans
# prospection_wifi/.env : inutile de la dupliquer si elle y figure déjà.
# Laissée vide, le script s'arrête avec un message explicite (aucun appel).
HUNTER_API_KEY=
